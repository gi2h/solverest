# Fortress Captcha v4.0 (Patchright)
# Railway Variables yang perlu di-set di service:
#   (kosong)  - default sudah bagus
#   BROWSER_TIMEOUT=90   - optional
#   API_KEY=xxx          - optional, kalau mau butuh auth

ENV=production
LOG_LEVEL=INFO
TASK_TTL_SECONDS=3600
MAX_CONCURRENT_SOLVES=4
SOLVE_TIMEOUT=180
BROWSER_TIMEOUT=90

# Optional vision service (kalau butuh image captcha)
VISION_URL=http://vision-solver.railway.internal:9002

# Optional API key
# API_KEY=

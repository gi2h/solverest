ENV=production
LOG_LEVEL=INFO
WORKERS=4

REDIS_URL=redis://default:password@redis:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_STREAM_MAXLEN=10000

API_HOST=0.0.0.0
API_PORT=8080
API_KEY=change-me-to-a-strong-secret
RATE_LIMIT_PER_MINUTE=60

CLOAK_HOST=cloak-service.railway.internal
CLOAK_PORT=9001
VISION_HOST=vision-service.railway.internal
VISION_PORT=9002
OCR_HOST=ocr-service.railway.internal
OCR_PORT=9003
WASM_HOST=wasm-service.railway.internal
WASM_PORT=9004
ALTCHA_HOST=altcha-service.railway.internal
ALTCHA_PORT=9005
FRIENDLY_HOST=friendly-service.railway.internal
FRIENDLY_PORT=9006
ROUTER_HOST=router-service.railway.internal
ROUTER_PORT=9007

VISION_MODEL_PATH=/app/models/qwen-vision
VISION_DEVICE=cpu
OCR_MODEL_PATH=/app/models/mobilenetv2_captcha.h5
HF_TOKEN=

OPENAI_API_KEY=
ROUTER_MODEL=gpt-4o

PROMETHEUS_ENABLED=true
METRICS_PORT=9090

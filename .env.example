# ═══════════════════════════════════════════════════════════════════════
# FORTRESS CAPTCHA - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════
# Railway Variables per-service (set di dashboard, tidak semua di sini):
#   api-gateway   → SERVICE=api-gateway, PORT=8080,
#                   FLARESOLVERR_URL, FLARESOLVERR_ENABLED, VISION_URL
#   vision-solver → SERVICE=vision, PORT=9002,
#                   QWEN_REPO, QWEN_LOCAL_DIR, RAILWAY_RUN_UID=0
#   flaresolverr  → PORT=8191, LOG_LEVEL=info, LOG_HTML=false, TZ=UTC
# ═══════════════════════════════════════════════════════════════════════

# ─── General ───────────────────────────────────────────────────────────
ENV=production
LOG_LEVEL=INFO

# ─── API Gateway ───────────────────────────────────────────────────────
PORT=8080
# API_KEY=              # kosong = public access, isi = butuh X-API-Key header
TASK_TTL_SECONDS=3600
MAX_CONCURRENT_SOLVES=8
SOLVE_TIMEOUT=180
BROWSER_TIMEOUT=120

# ─── Internal Service URLs (Railway private DNS) ───────────────────────
FLARESOLVERR_URL=http://flaresolverr.railway.internal:8191
FLARESOLVERR_ENABLED=1
VISION_URL=http://vision-solver.railway.internal:9002

# ─── Vision Service (Qwen VL) ──────────────────────────────────────────
QWEN_REPO=Qwen/Qwen2-VL-2B-Instruct
QWEN_LOCAL_DIR=/data/models/qwen
MODEL_DOWNLOAD_TIMEOUT=1800
# HF_TOKEN=             # isi kalau repo Qwen butuh auth
# RAILWAY_RUN_UID=0     # WAJIB di vision-solver kalau pakai volume

# ─── Legacy hostnames (untuk microservices di arsip.zip) ───────────────
ALTCHA_HOST=altcha-solver.railway.internal
ALTCHA_PORT=9005
FRIENDLY_HOST=friendly-solver.railway.internal
FRIENDLY_PORT=9006
OCR_HOST=ocr-solver.railway.internal
OCR_PORT=9003
CLOAK_HOST=cloak-service.railway.internal
CLOAK_PORT=9001
ROUTER_HOST=router-service.railway.internal
ROUTER_PORT=9007

# ─── Redis (OPSIONAL - hanya kalau mau pakai Redis queue) ──────────────
# REDIS_URL=redis://default:password@redis-host:6379

# ─── Observability ─────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

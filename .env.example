# ═══════════════════════════════════════════════════════════════════════
# FORTRESS CAPTCHA - Environment Variables
# Railway Variables yang perlu di-set di service api-gateway:
#   PORT=8080 (biar Railway inject, kosongkan saja — default sudah 8080)
#   FLARESOLVERR_ENABLED=1
#   FLARESOLVERR_URL=http://127.0.0.1:8191
# ═══════════════════════════════════════════════════════════════════════

# ─── General ───────────────────────────────────────────────────────────
ENV=production
LOG_LEVEL=INFO

# ─── API Gateway ───────────────────────────────────────────────────────
# PORT=8080                   # di-set otomatis oleh Railway
TASK_TTL_SECONDS=3600
MAX_CONCURRENT_SOLVES=8
SOLVE_TIMEOUT=180
BROWSER_TIMEOUT=120
# API_KEY=                    # kosong = public, isi = butuh X-API-Key

# ─── FlareSolverr (in-container, localhost) ────────────────────────────
FLARESOLVERR_ENABLED=1
FLARESOLVERR_URL=http://127.0.0.1:8191

# ─── Vision Service (OPSIONAL - service terpisah kalau butuh image OCR) ─
VISION_URL=http://vision-solver.railway.internal:9002
QWEN_REPO=Qwen/Qwen2-VL-2B-Instruct
QWEN_LOCAL_DIR=/data/models/qwen

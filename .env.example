# ─── Railway-injected (JANGAN isi manual) ─────────────────────────────
# PORT, RAILWAY_VOLUME_MOUNT_PATH, RAILWAY_ENVIRONMENT

# ─── WAJIB: set sama persis di SEMUA service ──────────────────────────
API_KEY=change-me-to-a-strong-secret

# ─── Redis (copy dari Railway Redis plugin) ───────────────────────────
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# ─── Internal hostnames (Railway private DNS) ─────────────────────────
ALTCHA_HOST=altcha-solver.railway.internal
ALTCHA_PORT=9005
FRIENDLY_HOST=friendly-solver.railway.internal
FRIENDLY_PORT=9006
VISION_HOST=vision-solver.railway.internal
VISION_PORT=9002
OCR_HOST=ocr-solver.railway.internal
OCR_PORT=9003

# ─── Model config (hanya untuk vision-solver) ─────────────────────────
QWEN_REPO=Qwen/Qwen3-VL-2B-Instruct
QWEN_LOCAL_DIR=/data/models/qwen
HF_TOKEN=
MODEL_DOWNLOAD_TIMEOUT=1800

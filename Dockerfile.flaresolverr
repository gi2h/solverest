# ═══════════════════════════════════════════════════════════════════════
# FlareSolverr — Chromium-based challenge solver
# Service name di Railway HARUS: flaresolverr (lowercase)
# ═══════════════════════════════════════════════════════════════════════
FROM ghcr.io/flaresolverr/flaresolverr:latest

# FlareSolverr v3.x respects $PORT env
ENV PORT=8191 \
    LOG_LEVEL=info \
    LOG_HTML=false \
    CAPTCHA_SOLVER=none \
    TZ=UTC

EXPOSE 8191

# Railway default healthcheck hits /health — FlareSolverr replies 404
# Use / instead which FlareSolverr handles
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
  CMD curl -fsS http://localhost:8191/ || wget -q -O- http://localhost:8191/ || exit 1

# Inherit CMD from base image (FlareSolverr's entrypoint)
